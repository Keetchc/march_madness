{
  "name": "march-madness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/predev-sync.mjs",
    "dev:sync": "npm run pull-dev-to-local && next dev",
    "pull-dev-to-local": "ts-node --project tsconfig.scripts.json scripts/pull-dynamo-dev-to-local.ts",
    "push-local-to-dev": "ts-node --project tsconfig.scripts.json scripts/push-local-to-dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "ts-node --project tsconfig.scripts.json scripts/create-tables.ts",
    "setup:dev-tables": "ts-node --project tsconfig.scripts.json scripts/create-tables.ts --prefix=mm-dev",
    "clone-dynamo-to-dev": "ts-node --project tsconfig.scripts.json scripts/clone-dynamo-tables.ts",
    "seed": "ts-node --project tsconfig.scripts.json scripts/seed-tournament.ts",
    "poll": "ts-node --project tsconfig.scripts.json scripts/poll-espn.ts",
    "inspect-bracket": "ts-node --project tsconfig.scripts.json scripts/inspect-bracket-picks.ts",
    "backfill-bracket-finals": "ts-node --project tsconfig.scripts.json scripts/backfill-bracket-picks-from-finals.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.540.0",
    "@aws-sdk/lib-dynamodb": "^3.540.0",
    "@next-auth/dynamodb-adapter": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.378.0",
    "next": "14.2.3",
    "next-auth": "^4.24.7",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.3.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
