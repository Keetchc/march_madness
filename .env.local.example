# ═══ Amplify Hosting — set these on the BRANCH that deploys (e.g. dev) ═════════
# Auth breaks with JSON "problem with the server configuration" / NO_SECRET if any are missing
# at RUNTIME (Lambda), not only at build. Plain "Environment variables" in the console is fine;
# if SSM-backed secrets fail to load, these will be empty and NextAuth will error.
#
# Server code uses lib/server-env.ts (`import { env } from "node:process"`) so webpack does not bake in
# empty literals for auth vars. amplify.yml echoes whether CodeBuild sees NEXTAUTH_* / GOOGLE_* (build logs).
# Optional: set DEPLOY_ENV_CHECK=1 or NEXTAUTH_DEBUG=1, redeploy, GET /api/runtime-env-check (booleans only).
#
#   NEXTAUTH_SECRET          (required in production — openssl rand -base64 32)
#   NEXTAUTH_URL             (https://your-app.amplifyapp.com or custom domain, no trailing slash)
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#
# Also set MM_REGION, MM_ACCESS_KEY_ID, MM_SECRET_ACCESS_KEY for DynamoDB (Amplify reserves AWS_*).

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Canonical public URL (Open Graph / iMessage link previews). In production set to https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
#
# If the app shows ?error=OAuthSignin, NextAuth failed before redirecting to Google — almost always:
#   - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET not set for SSR on the host (Amplify: branch env vars;
#     fix any failing SSM/secret wiring so they exist at runtime, not only at build).
#   - NEXTAUTH_URL must exactly match the site origin (https, no wrong host, usually no trailing slash).
#   - Google Console → Authorized redirect URIs must include:
#       https://YOUR_DOMAIN/api/auth/callback/google
# Optional: NEXTAUTH_DEBUG=1 logs more detail to server logs (CloudWatch on Amplify).

# ─── AWS / DynamoDB ───────────────────────────────────────────────────────────
# For local development these are set in docker-compose.yml automatically.
# For production, use real AWS credentials or an IAM role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Set this for local dev; leave empty for production (uses real AWS)
DYNAMODB_ENDPOINT=http://localhost:8000

# ─── App Config ───────────────────────────────────────────────────────────────
# Comma-separated Google email addresses of app admins
ADMIN_EMAILS=you@gmail.com

# Tournament lock date - picks close at this ISO timestamp
TOURNAMENT_LOCK_DATE=2026-03-19T12:00:00Z

# ESPN polling interval in ms (default 60s - only polls during active games)
ESPN_POLL_INTERVAL_MS=60000
