# ═══ Amplify Hosting — set these on the BRANCH that deploys (e.g. dev) ═════════
# Auth breaks with JSON "problem with the server configuration" / NO_SECRET if any are missing
# at RUNTIME (Lambda), not only at build. Plain "Environment variables" in the console is fine;
# if SSM-backed secrets fail to load, these will be empty and NextAuth will error.
#
# Amplify: artifacts are only `.next/`, so runtime Lambda often lacks console env vars. The build runs
# `scripts/amplify-prebuild-auth.js` (middleware Edge secret) and `scripts/write-amplify-auth-env.js`
# (`.next/amplify-auth.json` for Node /api/auth). `lib/hydrate-auth-env.ts` merges that file into
# `process.env` from the root layout and NextAuth route (instrumentation hook cannot use `fs` on Amplify).
# Optional: DEPLOY_ENV_CHECK=1 or NEXTAUTH_DEBUG=1 → GET /api/runtime-env-check (booleans only).
#
#   NEXTAUTH_SECRET          (required in production — openssl rand -base64 32)
#   NEXTAUTH_URL             (https://your-app.amplifyapp.com or custom domain, no trailing slash)
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#
# Also set MM_REGION, MM_ACCESS_KEY_ID, MM_SECRET_ACCESS_KEY for DynamoDB (Amplify reserves AWS_*).

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Canonical public URL (Open Graph / iMessage link previews). In production set to https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
#
# If the app shows ?error=OAuthSignin, NextAuth failed before redirecting to Google — almost always:
#   - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET not set for SSR on the host (Amplify: branch env vars;
#     fix any failing SSM/secret wiring so they exist at runtime, not only at build).
#   - NEXTAUTH_URL must exactly match the site origin (https, no wrong host, usually no trailing slash).
#   - Google Console → Authorized redirect URIs must include:
#       https://YOUR_DOMAIN/api/auth/callback/google
# Optional: NEXTAUTH_DEBUG=1 logs more detail to server logs (CloudWatch on Amplify).
# Bracket pick windows: configure in Admin → “Bracket picks” (lock time + open override).

# ─── AWS / DynamoDB ───────────────────────────────────────────────────────────
# For local development these are set in docker-compose.yml automatically.
# For production, use real AWS credentials or an IAM role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Set this for local dev; leave empty for production (uses real AWS)
DYNAMODB_ENDPOINT=http://localhost:8000

# Prefix for all app table names: `{prefix}-users`, `{prefix}-tournament`, `{prefix}-next-auth`, etc.
# Amplify (same values on **all** branches — no branch-only vars required):
#   DYNAMO_TABLE_PREFIX=mm
#   DYNAMO_TABLE_DEV_BRANCHES=dev   # comma-separated Git branch names that use dev tables (default dev)
# Optional same-everywhere: DYNAMO_TABLE_DEV_PREFIX=mm-dev (else dev prefix is {PREFIX}-dev)
# Builds use AWS_BRANCH (Amplify-injected) to pick mm vs mm-dev for `.next/amplify-auth.json`.
# Local: DYNAMO_TABLE_PREFIX=mm-dev or set AWS_BRANCH=dev with DYNAMO_TABLE_PREFIX=mm
DYNAMO_TABLE_PREFIX=mm
# DYNAMO_TABLE_DEV_BRANCHES=dev
# DYNAMO_TABLE_DEV_PREFIX=mm-dev

# ─── Pull AWS dev tables → DynamoDB Local ─────────────────────────────────────
# Requires: Docker DynamoDB Local up, `npm run setup`, AWS CLI profile or credentials
# that can read the source tables (dummy AWS_ACCESS_KEY_ID=local is ignored for the pull).
#   npm run pull-dev-to-local
# Or sync automatically before every `npm run dev`:
# SYNC_DYNAMO_ON_DEV=1
# DYNAMO_PULL_SOURCE_PREFIX=mm-dev
# DYNAMO_PULL_LOCAL_PREFIX=mm

# ─── Push DynamoDB Local → AWS mm-dev (reverse of pull) ───────────────────────
# Requires: DYNAMODB_ENDPOINT, DYNAMO_TABLE_PREFIX = local source (e.g. mm),
# real AWS credentials (dummy local keys are stripped for the destination).
#   npm run push-local-to-dev -- --force
# Optional: DYNAMO_PUSH_DEST_PREFIX=mm-dev  DYNAMO_PUSH_LOCAL_PREFIX=mm
# Create missing AWS tables first: npm run setup:dev-tables  (or add --create-dest)

# ─── App Config ───────────────────────────────────────────────────────────────
# Comma-separated Google accounts that can open /admin (must match Google login email exactly).
# On Amplify, set as a branch env var; it is copied into `.next/amplify-auth.json` at build.
ADMIN_EMAILS=you@gmail.com

# Tournament lock date - picks close at this ISO timestamp
TOURNAMENT_LOCK_DATE=2026-03-19T12:00:00Z

# ESPN polling interval in ms (default 60s - only polls during active games)
ESPN_POLL_INTERVAL_MS=60000
